# Variant to run. Valid values: classic, tbc, or wotlk.
CORE_VARIANT=classic
INSTALL_FULL_DB=TRUE

# (Optional) Comma-separated accounts: username:password[:gmlevel]
# When set, listed accounts are upserted and unused default seed accounts are removed.
# Expansion is derived from CORE_VARIANT. Usernames: letters/digits only.
# gmlevel: 0=PLAYER, 1=MODERATOR, 2=GAMEMASTER, 3=ADMINISTRATOR
#
# ACCOUNTS=admin:changeme:3,player:changeme

# Database defaults (everything on the same server)
DB_HOST=database
DB_PORT=3306
DB_USER=mangos
DB_PASS=mangos
DB_NAME=mangos
DB_ADMIN_USER=root
DB_ADMIN_PASS=mangos

# (Optional) Configure a separate login database.
#
# LOGIN_DB_HOST=
# LOGIN_DB_PORT=
# LOGIN_DB_USER=
# LOGIN_DB_PASS=
# LOGIN_DB_NAME=
# LOGIN_DB_ROOT_PASS=

# (Optional) Configure a separate world database.
#
# WORLD_DB_HOST=
# WORLD_DB_PORT=
# WORLD_DB_USER=
# WORLD_DB_PASS=
# WORLD_DB_NAME=
# WORLD_DB_ROOT_PASS=

# (Optional) Configure a separate characters database.
#
# CHARACTERS_DB_HOST=
# CHARACTERS_DB_PORT=
# CHARACTERS_DB_USER=
# CHARACTERS_DB_PASS=
# CHARACTERS_DB_NAME=
# CHARACTERS_DB_ROOT_PASS=

# (Optional) Configure a separate logs database.
#
# LOGS_DB_HOST=
# LOGS_DB_PORT=
# LOGS_DB_USER=
# LOGS_DB_PASS=
# LOGS_DB_NAME=
# LOGS_DB_ROOT_PASS=

# -----------------------------------------------------------------------------
# Server config overrides
#
# Conf keys map to env vars by replacing dots with underscores.
# MANGOSD_, REALMD_, and ANTICHEAT_ prefixes are stripped before matching;
# AIPLAYERBOT_, AUCTIONHOUSEBOT_, and AHBOT_ are kept (match conf key prefix):
#   Rate.XP.Kill                   -> MANGOSD_Rate_XP_Kill
#   WrongPass.MaxCount             -> REALMD_WrongPass_MaxCount
#   Enable                         -> ANTICHEAT_Enable
#   AiPlayerbot.Enabled            -> AIPLAYERBOT_Enabled
#   AuctionHouseBot.Seller.Enabled -> AUCTIONHOUSEBOT_Seller_Enabled
#   AhBot.Enabled                  -> AHBOT_Enabled
# -----------------------------------------------------------------------------

# realmd.conf
# https://github.com/cmangos/mangos-classic/blob/master/src/realmd/realmd.conf.dist.in
#
# REALMD_LOGLEVEL="1"
# REALMD_STRICTVERSIONCHECK="1"

# mangosd.conf
# https://github.com/cmangos/mangos-classic/blob/master/src/mangosd/mangosd.conf.dist.in
#
# MANGOSD_LOGLEVEL="1"
# MANGOSD_MOTD="Welcome to my server."
# MANGOSD_RATE_XP_KILL="2"

# anticheat.conf
# https://github.com/cmangos/mangos-classic/blob/master/src/game/Anticheat/module/anticheat.conf.dist.in
#
# ANTICHEAT_ENABLE="1"
# ANTICHEAT_KICKDELAY_MIN="30"
# ANTICHEAT_WARDEN_ENABLE="1"

# aiplayerbot.conf (requires a with-playerbot image)
# https://github.com/cmangos/playerbots/blob/master/playerbot/aiplayerbot.conf.dist.in
#
# AIPLAYERBOT_ENABLED="1"
# AIPLAYERBOT_RANDOMBOTRANDOMPASSWORD="1"
# AIPLAYERBOT_MAXRANDOMBOTS="150"

# ahbot.conf (requires a with-ahbot image)
# https://github.com/cmangos/playerbots/blob/master/ahbot/ahbot.conf.dist.in
#
# AHBOT_ENABLED="1"
# AHBOT_PRICEMULTIPLIER="0.35"


