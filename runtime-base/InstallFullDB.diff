source "$1"

try_set_mysql_path

if ! initialize; then
    exit 1
fi

BOT_EXP_PREFIX="classic"
if [ "$EXPANSION" = "TBC" ]; then
    BOT_EXP_PREFIX="tbc"
elif [ "$EXPANSION" = "WoTLK" ]; then
    BOT_EXP_PREFIX="wotlk"
fi

# table_exists "database" "table"
# Returns true when the named table already exists in the given database.
table_exists() {
    export MYSQL_PWD="$MYSQL_PASSWORD"
    local count
    count=$("$MYSQL_PATH" -u"$MYSQL_USERNAME" -h"$MYSQL_HOST" -P"$MYSQL_PORT" -s -N -D "$1" \
        -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = '$2';" 2>/dev/null)
    [ "$count" -ge 1 ]
}

# world_content_installed
# Returns true when the full world content db has already been imported. The
# base mangos.sql seeds db_version.version with "Mangos default database.";
# the content release overwrites that value during installation.
world_content_installed() {
    export MYSQL_PWD="$MYSQL_PASSWORD"
    local version
    version=$("$MYSQL_PATH" -u"$MYSQL_USERNAME" -h"$MYSQL_HOST" -P"$MYSQL_PORT" -s -N -D "$WORLD_DB_NAME" \
        -e "SELECT version FROM db_version LIMIT 1;" 2>/dev/null)
    [[ -n "$version" && "$version" != "Mangos default database"* ]]
}

if [[ "$2" == "WORLD" || "$2" == "CONTENT" ]]; then
    get_current_db_version "$WORLD_DB_NAME" "db_version"
    DB_WORLDDB_VERSION="$CURRENT_DB_VERSION"
    DB_LAST_CONTENT_VERSION_UPDATE="$CURRENT_LAST_CONTENT_DB_VERSION"
    STATUS_WORLD_DB_FOUND=true

    install_content=false
    if [[ "$2" == "CONTENT" ]]; then
        echo "Installing cmangos-world content"
        if world_content_installed; then
            echo "> Full world content db already installed, skipping."
        else
            install_content=true
        fi
    else
        echo "Installing cmangos-world database"
    fi

    if $install_content; then
        # apply_full_content_db applies world core updates itself.
        if ! apply_full_content_db; then
            exit 1
        fi
    else
        if ! apply_world_db_core_update; then
            exit 1
        fi
    fi
fi

if [[ "$2" == "WORLD" || "$2" == "CONTENT" ]]; then
    if [ "$PLAYERBOTS_DB" == "YES" ]; then
        if table_exists "$WORLD_DB_NAME" "ai_playerbot_rpg_races"; then
            echo "> Playerbots world db mods already applied, skipping."
        else
            echo "> Trying to apply playerbots sql mods for world db..."
            for UPDATEFILE in ${CORE_PATH}/src/modules/PlayerBots/sql/world/*.sql; do
                if [ -e "$UPDATEFILE" ]; then
                    fName=$(basename "$UPDATEFILE")
                    if ! execute_sql_file "$WORLD_DB_NAME" "$UPDATEFILE" "  - Applying $fName"; then
                        exit 1
                    fi
                fi
            done

            for UPDATEFILE in ${CORE_PATH}/src/modules/PlayerBots/sql/world/${BOT_EXP_PREFIX}/*.sql; do
                if [ -e "$UPDATEFILE" ]; then
                    fName=$(basename "$UPDATEFILE")
                    if ! execute_sql_file "$WORLD_DB_NAME" "$UPDATEFILE" "  - Applying $fName"; then
                        exit 1
                    fi
                fi
            done
        fi
    fi
fi

if [[ "$2" == "CHARACTERS" ]]; then
    echo "Updating cmangos-characters database"

    get_current_db_version "$CHAR_DB_NAME" "character_db_version"
    DB_CHARDB_VERSION="$CURRENT_DB_VERSION"
    STATUS_CHAR_DB_FOUND=true

    if ! apply_char_db_core_update; then
        exit 1
    fi

    if [ "$PLAYERBOTS_DB" == "YES" ]; then
        if table_exists "$CHAR_DB_NAME" "ai_playerbot_equip_cache"; then
            echo "> Playerbots characters db mods already applied, skipping (preserving bot caches)."
        else
            echo "> Trying to apply playerbots sql mods for characters db..."
            for UPDATEFILE in ${CORE_PATH}/src/modules/PlayerBots/sql/characters/*.sql; do
                if [ -e "$UPDATEFILE" ]; then
                    fName=$(basename "$UPDATEFILE")
                    if ! execute_sql_file "$CHAR_DB_NAME" "$UPDATEFILE" "  - Applying $fName"; then
                        exit 1
                    fi
                fi
            done
        fi
    fi
fi

if [[ "$2" == "LOGS" ]]; then
    echo "Updating cmangos-logs database"

    get_current_db_version "$LOGS_DB_NAME" "logs_db_version"
    DB_LOGSDB_VERSION="$CURRENT_DB_VERSION"
    STATUS_LOGS_DB_FOUND=true

    if ! apply_logs_db_core_update; then
        exit 1
    fi
fi

if [[ "$2" == "LOGIN" ]]; then
    echo "Updating cmangos-login database"

    get_current_db_version "$REALM_DB_NAME" "realmd_db_version"
    DB_REALMDB_VERSION="$CURRENT_DB_VERSION"
    STATUS_REALM_DB_FOUND=true

    if ! apply_realm_db_core_update; then
        exit 1
    fi
fi
